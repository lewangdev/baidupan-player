# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# LVGL 使用系统堆而非固定内存池:全部页面启动时一次建好(约 130 个对象),
# 固定 32KB 池实测耗尽(LV_ASSERT_MALLOC 死循环 → 看门狗);改用系统堆后按实际
# 用量占用,且 TLS/音频缓冲与界面共用同一份剩余内存。
CONFIG_LV_USE_CLIB_MALLOC=y
# 网盘授权二维码。
CONFIG_LV_USE_QRCODE=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth ---
# 百度网盘随身听不使用 BLE(省约 50KB 堆,留给 TLS 与音频缓冲)。
CONFIG_BT_ENABLED=n

# --- 内存(无 PSRAM:下载 TLS + MP3 解码 + 环形缓冲 + 界面共用约 200 KB 内部 RAM) ---
# C3 的 IRAM 与 DRAM 是同一块 SRAM:放进 IRAM 的代码直接减少堆。播放 MP3 只需约
# 16 KB/s 吞吐,不需要 Wi-Fi 收发路径的 IRAM 加速;FreeRTOS 也放回 Flash。
# 实测:不这样做时 CDN 的 TLS 记录缓冲(16.7 KB 连续)分配失败,播放报网络错误。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# --- 网络与 TLS ---
# 动态 TLS 缓冲:握手后按需释放;入站记录保持 16 KiB(百度 CDN 不协商更小的记录)。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# 握手后不保留服务器证书链(每条连接约 4 KB);长时间下载期间这部分一直占着堆。
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# 小接收窗口与 RX 缓冲限制 lwIP 堆积的 pbuf;MP3 码率下吞吐绰绰有余。
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
